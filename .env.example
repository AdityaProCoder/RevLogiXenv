# RevLogiXenv Configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# LLM API Credentials
# ---------------------------------------------------------------------------

# Primary model and base URL
# Default is https://router.huggingface.co/v1
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=gpt-4.1-mini

# Your Hugging Face Token (used by inference.py and run_baseline.py)
HF_TOKEN=hf_your_token_here

# ---------------------------------------------------------------------------
# Environment Execution
# ---------------------------------------------------------------------------

# Use 'easy', 'medium', or 'hard'
REVLOGIXENV_TASK=easy

# Local environment server URL (default: http://localhost:8000)
ENV_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# (Optional) Local Baseline Run Settings
# ---------------------------------------------------------------------------
baseline_provider=openai
baseline_model=gpt-4.1-mini
baseline_temp=0.1
